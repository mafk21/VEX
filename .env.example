# VEX environment configuration — all optional, all local.
# Copy to .env.local for `next dev`, or export in your shell.

# Where VEX stores keys (config.json) and the SQLite database.
# Default: ~/.vex
#VEX_DATA_DIR=~/.vex

# Port for the local server (default 3000).
#PORT=3000

# Demo mode: run the full scan pipeline with canned, clearly-labeled
# findings — no Gemini key or API access needed. Great for trying the UI.
#VEX_MOCK_GEMINI=1

# Only if your network does TLS interception (corporate proxy):
#NODE_EXTRA_CA_CERTS=/path/to/your/ca.pem
